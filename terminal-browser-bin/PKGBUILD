# Maintainer: Ujhhgtg
pkgname=terminal-browser-bin
pkgver=0.5.8
pkgrel=1
pkgdesc='A real browser that runs inside your terminal'
arch=('x86_64')
url='https://terminal-browser.sh/'
license=('MIT')
depends=('alsa-lib' 'gtk3' 'mesa' 'nss')
provides=('terminal-browser')
conflicts=('terminal-browser')
options=('!strip')
source=(
  "https://terminal-browser.sh/install/dl/stable/v${pkgver}/terminal-browser-linux-x64.tar.gz"
  "LICENSE::https://raw.githubusercontent.com/zenbu-labs/terminal-browser/v${pkgver}/LICENSE"
)
noextract=('terminal-browser-linux-x64.tar.gz')
sha256sums=(
  'c330be3341ef6f6cb106e4fb32c1d60754a08e1a7641143a7a6a4d9e9448f617'
  '75144b0fa61c38989a1a057a018806a2da36e99f1f8850ba6146d9f53bdd646f'
)

package() {
  install -d "$pkgdir/opt/terminal-browser"
  tar -xzf "terminal-browser-linux-x64.tar.gz" \
    -C "$pkgdir/opt/terminal-browser" --strip-components=1 --no-same-owner

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/terminal-browser" <<'EOF'
#!/bin/sh
exec /opt/terminal-browser/bin/terminal-browser "$@"
EOF

  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
