package() {
    install -Dm755 "${srcdir}/$pkgname" "${pkgdir}/usr/bin/$pkgname"
    install -Dm644 "${srcdir}/$pkgname.conf" "${pkgdir}/etc/$pkgname.conf"
    install -Dm644 "${srcdir}/$pkgname.hook" "${pkgdir}/usr/share/libalpm/hooks/$pkgname.hook"
    install -Dm644 "${srcdir}/$pkgname-restore.hook" "${pkgdir}/usr/share/libalpm/hooks/$pkgname-restore.hook"
    install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/$pkgname/README.md"
    install -Dm644 -t "${pkgdir}/usr/share/$pkgname" "${srcdir}/"{"$pkgname.conf",stats.js,accounts.js,account-host.js,account-keyring.py,account-patch.py}
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
